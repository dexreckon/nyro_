{
  "model": "claude-haiku-5-5",
  "effort": "low",
  "persona_overrides": {
    "fileclerk": { "timeout_seconds": 900, "max_turns": 24 },
    "desktopctl": { "timeout_seconds": 600, "max_turns": 40 }
  },
  "island": { "enabled": true, "port": 8767 },
  "languages": [
    "en",
    "ur"
  ],
  "budget": {
    "daily_request_cap": 400,
    "warn_ratio": 0.8,
    "hourly_pace_warn": 60,
    "db_path": "nyro_state.sqlite3",
    "local_commands_always_on": true
  },
  "vision": {
    "target_width": 800,
    "webp_quality": 75
  },
  "session": {
    "reset_every_turns": 5
  },
  "wake_word": {
    "engine": "openwakeword",
    "phrase": "Hey Nyro",
    "model_path": "models/hey_nyro.onnx",
    "threshold": 0.5,
    "hotkey": "ctrl+alt+n"
  },
  "firewall": {
    "allowed_roots": [],
    "trash_dirname": ".nyro_trash",
    "protected_path_prefixes": [
      "C:\\Windows",
      "C:\\Program Files",
      "C:\\Program Files (x86)",
      "C:\\ProgramData",
      "/etc",
      "/usr",
      "/bin",
      "/sbin",
      "/boot",
      "/sys",
      "/proc"
    ],
    "protected_path_fragments": [
      "system32",
      "syswow64",
      "\\config\\sam",
      "ntuser.dat"
    ],
    "blocked_processes": [
      "csrss.exe",
      "wininit.exe",
      "winlogon.exe",
      "lsass.exe",
      "services.exe",
      "smss.exe",
      "svchost.exe",
      "explorer.exe",
      "system"
    ]
  },
  "overlay": {
    "bridge_host": "127.0.0.1",
    "bridge_port": 8765,
    "clear_hotkey": "ctrl+shift+x"
  },
  "data_dir": "nyro_data",
  "approval": {
    "host": "127.0.0.1",
    "port": 8766,
    "timeout_seconds": 120
  },
  "claude": {
    "use_bare": false,
    "cli": "claude",
    "timeout_seconds": 120,
    "max_turns": 8
  },
  "screencoach": {
    "click_timeout_seconds": 90,
    "click_pad_px": 8
  },
  "webpilot": {
    "cdp_url": "http://127.0.0.1:9222",
    "allowed_schemes": [
      "http",
      "https"
    ]
  },
  "relay": {
    "url": "ws://127.0.0.1:8000/ws/host",
    "token_env": "NYRO_PAIR_TOKEN"
  },
  "voice": {
    "stt_model": "small",
    "voices": {
      "en": "en-US-AriaNeural",
      "ur": "ur-PK-UzmaNeural"
    }
  }
}
