# Your public domain (A record -> this VPS):
NYRO_DOMAIN=nyro.example.com
# Long random secret shared by the laptop and the phone. Generate with:  openssl rand -hex 32
NYRO_PAIR_TOKEN=change-me-to-64-hex-chars-from-openssl-rand
# Host port the relay listens on (127.0.0.1 only). Change if 8000 is already used on your VPS:
NYRO_PORT=8000
# Only for docker-compose.network.yml: the name of your existing proxy's Docker network (docker network ls)
# NYRO_PROXY_NETWORK=proxy
